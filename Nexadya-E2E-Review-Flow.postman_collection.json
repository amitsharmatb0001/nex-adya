{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
		"name": "Nexadya - E2E Review Flow",
		"description": "A complete end-to-end test flow for a user placing an order, the restaurant processing it, the user leaving a review, and the owner replying.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "USER FLOW",
			"item": [
				{
					"name": "1. User Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"user_token\", jsonData.data.token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"password\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Logs in the default test user created by the seeder."
					},
					"response": []
				},
				{
					"name": "2. User Creates an Address",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"address_id\", jsonData.data.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{user_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"label\": \"Home\",\n    \"line1\": \"123 Test Street\",\n    \"city\": \"Testville\",\n    \"state\": \"Testing\",\n    \"pincode\": \"123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/addresses",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"addresses"
							]
						},
						"description": "Creates a delivery address for the user. The address ID is saved."
					},
					"response": []
				},
				{
					"name": "3. User Places an Order",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"order_id\", jsonData.data.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{user_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"restaurant_id\": 1,\n    \"address_id\": {{address_id}},\n    \"items\": [\n        {\n            \"menu_item_id\": 1,\n            \"quantity\": 2\n        },\n        {\n            \"menu_item_id\": 2,\n            \"quantity\": 1\n        }\n    ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/orders",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"orders"
							]
						},
						"description": "Places an order at Restaurant #1 with Menu Items #1 and #2. The new order ID is saved."
					},
					"response": []
				}
			]
		},
		{
			"name": "OWNER FLOW",
			"item": [
				{
					"name": "4. Owner Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"owner_token\", jsonData.data.token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"owner@restaurant1.com\",\n    \"password\": \"password\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v2/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v2",
								"auth",
								"login"
							]
						},
						"description": "Logs in as the restaurant owner. Assumes an owner for restaurant #1 exists with this email."
					},
					"response": []
				},
				{
					"name": "5. Owner Updates Order Status",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{owner_token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"{{order_status}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v2/orders/{{order_id}}/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v2",
								"orders",
								"{{order_id}}",
								"status"
							]
						},
						"description": "This is a template request. Duplicate it for each status update: confirmed, preparing, out-for-delivery, delivered. Set the `order_status` variable in each duplicated request."
					},
					"response": []
				}
			]
		},
		{
			"name": "REVIEW FLOW",
			"item": [
				{
					"name": "6. User Posts a Review",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"review_id\", jsonData.data.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{user_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"rating\": 5,\n    \"comment\": \"The food was amazing and arrived hot! Excellent service.\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/restaurants/1/reviews",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"restaurants",
								"1",
								"reviews"
							]
						},
						"description": "After the order is delivered, the user posts a review for the restaurant. The new review ID is saved."
					},
					"response": []
				},
				{
					"name": "7. Owner Replies to Review",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{owner_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"reply\": \"Thank you so much for your kind words! We're thrilled you enjoyed your meal and look forward to serving you again soon.\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v2/reviews/{{review_id}}/reply",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v2",
								"reviews",
								"{{review_id}}",
								"reply"
							]
						},
						"description": "The restaurant owner logs in and replies to the user's review."
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "user_token",
			"value": ""
		},
		{
			"key": "owner_token",
			"value": ""
		},
		{
			"key": "order_id",
			"value": ""
		},
		{
			"key": "review_id",
			"value": ""
		},
		{
			"key": "address_id",
			"value": ""
		}
	]
}
